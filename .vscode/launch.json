{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Current Jest File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest",
      "args": [
        "--runTestsByPath",
        "${relativeFileDirname}/${fileBasename}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "port": 9229
    }
  ]
}
